{
  "name": "koso",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "test": "pnpm run \"/^(check|lint|test:unit)$/\" && pnpm run test:integration",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest run"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">= 20"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@floating-ui/dom": "1.8.0",
    "@lucide/svelte": "1.73.0",
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/eslint": "9.6.1",
    "@types/node": "26.6.6",
    "clsx": "2.1.1",
    "codemirror": "6.0.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "google-oauth-gsi": "4.0.1",
    "highlight.js": "11.12.0",
    "immutable": "5.2.1",
    "js-base64": "3.9.6",
    "jsdom": "31.0.1",
    "jwt-decode": "4.0.0",
    "kosui": "0.5.0",
    "lib0": "0.2.120",
    "marked": "18.2.0",
    "mermaid": "12.3.0",
    "mockdate": "3.0.5",
    "mode-watcher": "1.1.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-jsdoc": "1.8.1",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-confetti": "2.3.2",
    "svelte-sonner": "1.2.3",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.2",
    "tailwindcss": "4.3.5",
    "tslib": "2.9.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "uuid": "14.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1",
    "y-codemirror.next": "0.3.6",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.7",
    "y-webrtc": "10.3.0",
    "yjs": "13.6.33"
  },
  "pnpm": {
    "overrides": {
      "cookie": "2.0.2"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
